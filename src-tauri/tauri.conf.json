{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CATS Configurator",
  "version": "2.0.1",
  "identifier": "com.cats.cats-configurator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CATS Configurator",
        "width": 1700,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMzVFMjVFNjc3NkEwMDkKUldRSm9IWm5YdUkxOFpISXlOTkRNWjRIZ1luV2ROd09ZaVFjMlBqQWVMVWpIcjBaUWdsUE5ldCsK",
      "endpoints": [
        "https://github.com/catsystems/cats-configurator/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Control and Telemetry Systems GmbH",
    "category": "Utility",
    "shortDescription": "Configure CATS flight computers and inspect flight logs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
