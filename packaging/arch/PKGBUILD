# Build from a CATS Configurator checkout with scripts/build-arch-package.sh.
pkgname=cats-configurator
_checkout=$(realpath "$startdir/../..")
_version=$(sed -n 's/^  "version": "\([^"]*\)",$/\1/p' "$_checkout/package.json")
# Arch sorts a suffix like 2.0.3rc.1 before the final 2.0.3.
pkgver=${_version//-/}
pkgrel=1
pkgdesc='Configure CATS flight computers and inspect flight logs'
arch=('x86_64')
url='https://github.com/catsystems/cats-configurator'
license=('GPL-3.0-only')
depends=(
  'cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme'
  'libgcc' 'libsoup3' 'openssl' 'systemd' 'webkit2gtk-4.1' 'xdg-utils'
)
makedepends=('cargo' 'nodejs-lts-krypton' 'npm' 'pkgconf')
checkdepends=('desktop-file-utils')
options=('!debug')

build() {
  cd "$_checkout"
  node -e 'if (process.versions.node.split(".")[0] !== "24") throw Error("Use Node.js 24 to build Configurator")'
  npm ci --no-audit
  CARGO_TARGET_DIR="$_checkout/src-tauri/target" npm run build -- --no-bundle -- --locked
}

check() {
  desktop-file-validate "$_checkout/packaging/arch/com.cats.cats-configurator.desktop"
  udevadm verify "$_checkout/src-tauri/resources/70-cats-devices.rules"
}

package() {
  install -Dm755 "$_checkout/src-tauri/target/release/cats-configurator" \
    "$pkgdir/usr/bin/cats-configurator"
  install -Dm644 "$_checkout/packaging/arch/com.cats.cats-configurator.desktop" \
    "$pkgdir/usr/share/applications/com.cats.cats-configurator.desktop"
  install -Dm644 "$_checkout/src-tauri/icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/cats-configurator.png"
  install -Dm644 "$_checkout/src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/cats-configurator.png"
  install -Dm644 "$_checkout/src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/cats-configurator.png"
  install -Dm644 "$_checkout/src-tauri/resources/70-cats-devices.rules" \
    "$pkgdir/usr/lib/udev/rules.d/70-cats-devices.rules"
}
