{
  "name": "cats-configurator",
  "version": "1.3.1",
  "description": "Desktop configuration and flight-log analysis utility for CATS flight computers.",
  "author": "CATS Systems",
  "private": true,
  "main": "out/main/background.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:app": "electron-vite build",
    "build:dir": "electron-vite build && electron-builder --dir",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "verify:production-target": "node tests/verify-production-target.mjs",
    "verify:release-contract": "node tests/verify-release-contract.mjs",
    "verify:release-tag": "node tests/verify-release-tag.mjs",
    "verify:packaged-artifact": "node tests/verify-packaged-artifact.mjs",
    "test:hardware": "node tests/hardware/vega-smoke.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "plotly.js-dist-min": "^3.7.0",
    "semver": "^7.8.5",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "pinia": "^4.0.2",
    "prettier": "^3.9.0",
    "sass": "^1.101.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.8"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "build": {
    "appId": "com.cats.cats-configurator",
    "directories": {
      "buildResources": "build",
      "output": "builds"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${name} Setup ${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "${name}-${version}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
